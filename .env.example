# Copy to .env and fill per client. .env is gitignored — NEVER commit real values.

# Apps Script form backend: the deployed web-app /exec URL (public endpoint).
PUBLIC_FORM_ENDPOINT=

# Resend form backend (used only by the serverless function, NOT client code):
RESEND_API_KEY=

# Netlify Forms needs no keys here — notifications are configured in the
# Netlify UI or the netlify/functions notification function.
