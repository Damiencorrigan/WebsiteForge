{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "comment": "Indexable pages (homepage + any real content pages): full bar incl. SEO=100.",
          "matchingUrlPattern": "^http://[^/]+/(index\\.html)?$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }]
          }
        },
        {
          "comment": "noindex pages (404/privacy/thanks): SEO is intentionally penalized for being blocked from indexing, so drop the SEO bar and keep perf/a11y/BP.",
          "matchingUrlPattern": ".*(404|privacy|thanks).*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
