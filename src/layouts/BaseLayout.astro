---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCallCTA from '../components/StickyCallCTA.astro';
import { business } from '../data/business-info.ts';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, path, noindex, ogImage } = Astro.props;
const lang = 'en-AU';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Preload the two self-hosted fonts (no CDN). -->
    <link rel="preload" href="/fonts/barlow-condensed-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} path={path} noindex={noindex} ogImage={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1a3a5c" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCallCTA />
    <!-- Extra bottom padding so the mobile sticky bar never covers the footer. -->
    <div class="sticky-spacer" aria-hidden="true"></div>
    <style>
      .sticky-spacer { height: 0; }
      @media (max-width: 640px) { .sticky-spacer { height: 56px; } }
    </style>
  </body>
</html>
<!-- Site: {business.displayName} -->
