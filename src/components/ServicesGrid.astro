---
import { services } from '../data/services.ts';
---

<section id="services" aria-labelledby="services-h">
  <div class="container">
    <h2 id="services-h">What we do</h2>
    <ul class="grid" role="list">
      {
        services.map((s) => (
          <li class="card" id={`service-${s.slug}`}>
            <h3>{s.name}</h3>
            <p>{s.blurb}</p>
            {s.detail && <p class="detail">{s.detail}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: var(--brand-primary);
    margin-bottom: 1.5rem;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .card {
    border: 1px solid var(--brand-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    background: var(--brand-surface);
  }
  .card h3 {
    color: var(--brand-primary);
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
  }
  .card p {
    margin: 0;
    color: var(--brand-ink);
  }
  /* The wedge service (formwork) carries a longer paragraph — give it room. */
  .card:has(.detail) {
    grid-column: 1 / -1;
    background: var(--brand-surface-2);
  }
  .detail {
    margin-top: 0.75rem;
    color: var(--brand-muted);
    max-width: 70ch;
  }
</style>
