---
/**
 * Seo.astro — title / meta / canonical / Open Graph / Twitter / JSON-LD, all
 * in ONE place. og:image is an ABSOLUTE URL (WhatsApp/FB reject relative — TVA
 * lesson). JSON-LD reads business-info via lib/jsonld.ts.
 */
import { business } from '../data/business-info.ts';
import { jsonLdGraph } from '../lib/jsonld.ts';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. '/thanks'. Canonical is built from business.siteUrl. */
  path?: string;
  noindex?: boolean;
  ogImage?: string; // path under /, e.g. '/og.jpg'
}

const { title, description, path = '/', noindex = false, ogImage = '/og.jpg' } = Astro.props;
const canonical = new URL(path, business.siteUrl).href;
const ogAbsolute = new URL(ogImage, business.siteUrl).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogAbsolute} />
<meta property="og:site_name" content={business.displayName} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogAbsolute} />

{!noindex && <script type="application/ld+json" set:html={jsonLdGraph()} />}
